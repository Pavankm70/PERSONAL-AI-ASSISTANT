# ==========================================
# AURELIA AI - Backend Configuration (.env)
# ==========================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="AURELIA AI"
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database configuration
# For Postgres with pgvector (e.g. Neon): postgresql+psycopg://user:password@ep-xyz.neon.tech/aurelia_db?sslmode=require
# For standalone local development: sqlite:///./aurelia.db
DATABASE_URL=sqlite:///./aurelia.db

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# Session & Security
# 32-byte base64 key for AES-256-GCM encryption of OAuth tokens at rest
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=dGhpc2lzYXRlc3RrZXlmb3JhZXMyNTZnY21lbmM=
SESSION_SECRET=aurelia-super-secret-session-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================================
# Phase 1: Google OAuth Credentials (Google Cloud Console)
# ========================================================
# 1. Create an OAuth 2.0 Web Client ID in Google Cloud Console
# 2. Add Authorized Redirect URI: http://localhost:8000/api/auth/google/callback
# 3. Add Authorized JavaScript Origin: http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google OAuth Scopes used by Aurelia AI:
# - Identity (Sign-in): openid, userinfo.email, userinfo.profile
# - Gmail (Connected Inbox): https://www.googleapis.com/auth/gmail.readonly
# - Calendar (Agenda & Planning): https://www.googleapis.com/auth/calendar.events, https://www.googleapis.com/auth/calendar.readonly
# - Drive (Document Vault): https://www.googleapis.com/auth/drive.readonly

# ==========================================
# AI Orchestration Provider (Future Phases)
# ==========================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=

# Embeddings & RAG
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-004
VECTOR_STORE=sqlite-fts

# External Tools / Research APIs (Optional)
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEATHER_API_KEY=
